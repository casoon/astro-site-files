---
import { readFile } from 'node:fs/promises';
import { join, resolve } from 'node:path';
import { defaultRegistry, renderRobotsTxt, type Preset } from '@casoon/astro-site-files';
import {
  Badge,
  Badges,
  CallToAction,
  CodeBlock,
  Compare,
  Faq,
  Features,
  FileSet,
  Flow,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
  Spotlight,
  StatBand,
  Terminal,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import pages from 'virtual:casoon-pages/config';
import { url } from '@casoon/pages-theme/url';
import { generatedFile } from '../inline-generated-files';

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = pages.changelog
  ? parseChangelog(await readFile(pages.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

// ── Figures from the package source, so they cannot drift from the release ──────────────────
const repoRoot = resolve(process.cwd(), '..');
const source = (path: string) => readFile(join(repoRoot, path), 'utf8');

const manifest = JSON.parse(await source('package.json'));
const runtimeDependencies = Object.keys(manifest.dependencies ?? {}).length;
// Every file the integration can write; each name must appear where it is written.
const writerSource = (await source('src/integration.ts')) + (await source('src/sitemap/build.ts'));
const fileNames = ['robots.txt', 'sitemap.xml', 'llms.txt', 'llms-full.txt', 'rss.xml', 'security.txt', 'humans.txt'];
for (const name of fileNames) {
  if (!writerSource.includes(`'${name}'`)) throw new Error(`${name} is not written by the integration`);
}
const auditRules = new Set(
  [await source('src/audit.ts'), await source('src/sitemap/audit.ts')].flatMap((code) =>
    [...code.matchAll(/rule: '([a-z]+\/[a-z-]+)'/g)].map((m) => m[1])
  )
).size;
if (!auditRules) throw new Error('src/audit.ts: no audit rules found');

// ── Preset matrix, rendered with the package itself ──────────────────────────────────────────
// Each row names real crawlers; every cell is read from the robots.txt the preset produces.
// A row whose crawlers end up with different verdicts fails the build instead of guessing.
const presetColumns: { preset: Preset; label: string }[] = [
  { preset: 'seoOnly', label: 'Search only' },
  { preset: 'blockTraining', label: 'No training at all' },
  { preset: 'citationFriendly', label: 'Cite, no pure training' },
  { preset: 'openToAi', label: 'Everything open' },
];
const crawlerRows = [
  { topic: 'Search engines', bots: ['Googlebot', 'Bingbot'] },
  { topic: 'AI search and live answers', bots: ['OAI-SearchBot', 'ChatGPT-User', 'Claude-SearchBot', 'PerplexityBot'] },
  { topic: 'Answers and training in one', bots: ['ClaudeBot', 'Google-Extended', 'meta-externalagent'] },
  { topic: 'Training only', bots: ['GPTBot', 'CCBot', 'Applebot-Extended'] },
  { topic: 'Unverified AI scrapers', bots: ['Diffbot', 'FirecrawlAgent'] },
  { topic: 'Web archives', bots: ['ia_archiver', 'archive.org_bot'] },
];

/** The verdict robots.txt gives one crawler: its own group, else `User-agent: *`. */
function allows(robots: string, userAgent: string): boolean {
  const groups = robots.split('\n\n').map((block) => block.split('\n'));
  const own = groups.find((lines) => lines.includes(`User-agent: ${userAgent}`));
  const group = own ?? groups.find((lines) => lines.includes('User-agent: *'));
  if (!group) throw new Error(`robots.txt has no group for ${userAgent} and no global group`);
  return !group.includes('Disallow: /');
}

const known = new Set(defaultRegistry.flatMap((bot) => bot.userAgents));
const presetRows = crawlerRows.map(({ topic, bots }) => {
  for (const bot of bots) if (!known.has(bot)) throw new Error(`${bot} is not in the bot registry`);
  return {
    topic: `${topic} (${bots.join(', ')})`,
    cells: presetColumns.map(({ preset }) => {
      const robots = renderRobotsTxt({ preset });
      const verdicts = new Set(bots.map((bot) => allows(robots, bot)));
      if (verdicts.size !== 1) throw new Error(`${preset}: "${topic}" crawlers get different verdicts`);
      return verdicts.has(true) ? '**Allowed**' : 'Blocked';
    }),
  };
});

const config = `import { defineConfig } from 'astro/config'
import siteFiles from '@casoon/astro-site-files'

export default defineConfig({
  site: 'https://example.com',
  integrations: [
    siteFiles({
      robots: { preset: 'citationFriendly' },
      llms: { title: 'Example', description: 'An example website.' },
      security: { contact: 'mailto:security@example.com', expires: '2027-03-01T00:00:00.000Z' },
      humans: { team: [{ name: 'Alice', role: 'Development' }] },
    }),
  ],
})`;

// The hero shows the options object alone; the quickstart below has the whole file.
const heroConfig = `siteFiles({
  robots: { preset: 'citationFriendly' },
  sitemap: {},
  llms: { title: 'Example', description: 'A demo.' },
  security: { contact: 'mailto:sec@example.com' },
  humans: { team: [{ name: 'Alice' }] },
})`;

// Every file this site's own build wrote, in the order the documentation introduces them.
const generated = [
  { id: 'robots', name: 'robots.txt', path: 'dist/robots.txt' },
  { id: 'llms', name: 'llms.txt', path: 'dist/llms.txt' },
  { id: 'sitemap', name: 'sitemap.xml', path: 'dist/sitemap.xml' },
  { id: 'security', name: 'security.txt', path: 'dist/.well-known/security.txt' },
  { id: 'humans', name: 'humans.txt', path: 'dist/humans.txt' },
];
---

<Base>
  <Hero
    layout="stack"
    command="astro build"
    title="Control what search engines and AI see of your site."
    lead="robots.txt, sitemap.xml and llms.txt, plus security.txt and humans.txt: written into dist/ on every astro build, from one typed config. Below are the files this site's own build wrote."
  >
    <CodeBlock slot="source" code={heroConfig} lang="ts" title="astro.config.ts" label="TypeScript" />
    <FileSet slot="output" files={generated}>
      <Fragment slot="robots" set:html={generatedFile('robots.txt')} />
      <Fragment slot="llms" set:html={generatedFile('llms.txt')} />
      <Fragment slot="sitemap" set:html={generatedFile('sitemap.xml')} />
      <Fragment slot="security" set:html={generatedFile('.well-known/security.txt')} />
      <Fragment slot="humans" set:html={generatedFile('humans.txt')} />
    </FileSet>
    <Install
      commands={[
        { label: 'npm', command: 'npm install @casoon/astro-site-files' },
        { label: 'pnpm', command: 'pnpm add @casoon/astro-site-files' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>npm {pages.version}</Badge>
      <Badge>Astro ≥ 6</Badge>
      <Badge>Node.js ≥ 22.12</Badge>
    </Badges>
  </Hero>

  <StatBand
    items={[
      { value: String(fileNames.length), label: 'file types written at build time' },
      { value: String(defaultRegistry.length), label: 'crawlers in the bot registry' },
      { value: String(auditRules), label: 'audit rules in the build log' },
      { value: String(runtimeDependencies), label: 'runtime dependencies' },
    ]}
  />

  <Compare
    title="Choose who may read, cite and train on your site"
    lead="A preset turns one decision into a rule for every crawler the registry knows. Each cell below is read from the robots.txt that preset produces with this release. `lockdown` blocks everything, search engines included; single bots and whole groups can be overridden."
    topicLabel="Crawler group"
    columns={presetColumns.map(({ preset, label }) => ({ title: preset, label }))}
    rows={presetRows}
    link={{ label: 'Which preset fits which goal', href: url('docs/guides/ai-crawlers/') }}
  />

  <Flow
    eyebrow="How it works"
    title="From your config to files in dist/"
    lead="The integration runs once, after Astro has built every page. Nothing is served at runtime."
    stages={[
      {
        label: 'Configure',
        artifact: 'astro.config.mjs',
        title: 'Typed options',
        body: 'One options object per file. robots.txt and sitemap.xml are on by default, the others once you configure them.',
      },
      {
        label: 'Build',
        artifact: 'astro build',
        title: 'Astro renders',
        body: 'Pages, redirects and i18n fallback routes are collected while Astro builds, with `site` and `base` from your config.',
      },
      {
        label: 'Write',
        artifact: 'dist/',
        title: 'Files from the output',
        body: 'The sitemap lists what was actually built; robots.txt then points at the sitemap file that was written.',
      },
      {
        label: 'Check',
        artifact: 'build log',
        title: 'Audit',
        body: 'Rules warn about what would hurt in production, such as an expired security.txt or legal pages blocked for crawlers.',
      },
    ]}
  />

  <Spotlight
    eyebrow="sitemap.xml"
    title="A sitemap of what was really built"
    lead="**Pages come from the build output, not from a route list you maintain.** What Astro did not build cannot end up in the sitemap."
    points={[
      '**Redirects and pages marked noindex are left out**, so the sitemap never lists a URL a crawler should not index.',
      '**hreflang alternates follow your Astro i18n config**, fallback routes included.',
      '**Large sites switch to a sitemap index** above 50,000 URLs, and robots.txt references whichever file was written.',
    ]}
    links={[
      { label: 'sitemap.xml', href: url('docs/configuration/sitemap-xml/') },
      { label: 'site URL and base', href: url('docs/guides/site-url-and-base/') },
    ]}
  >
    <Terminal title="dist/sitemap.xml" dots>
      <Fragment set:html={generatedFile('sitemap.xml', 16)} />
    </Terminal>
  </Spotlight>

  <Features
    layout="grid"
    heading="The other files, and what keeps them right"
    items={[
      {
        icon: 'L',
        title: 'llms.txt and llms-full.txt',
        body: 'Title, summary and link sections in the llmstxt.org format, plus an optional llms-full.txt with the full Markdown of your pages. Relative links resolve against site and base.',
      },
      {
        icon: 'S',
        title: 'security.txt by RFC 9116',
        body: 'Written to .well-known/ with contact, expiry, policy and preferred languages. The audit warns when the file has expired or carries no expiry date.',
      },
      {
        icon: 'H',
        title: 'humans.txt',
        body: 'Team, thanks, technology and a note in the humanstxt.org layout, from the same config as everything else.',
      },
      {
        icon: 'R',
        title: 'RSS feed',
        body: 'An RSS 2.0 feed written at build time, or served from an API route when the feed has to stay current.',
      },
      {
        icon: 'T',
        title: 'Typed per file',
        body: 'RobotsOptions, LlmsOptions, SitemapOptions, SecurityOptions and HumansOptions are exported for your own config modules.',
      },
      {
        icon: '!',
        title: 'Audited during the build',
        body: `${auditRules} rules report problems in the build log, among them a contact without URI scheme and unresolvable links in llms.txt.`,
      },
    ]}
  />

  <Quickstart
    lead="Three steps from install to generated files. The full walkthrough lives in the documentation."
    steps={[
      'Install the package and set <code>site</code> in your Astro config.',
      'Add <code>siteFiles()</code> to <code>integrations</code> with the files you want.',
      'Run <code>astro build</code>. The files are written to <code>dist/</code>.',
    ]}
  >
    <CodeBlock code={config} lang="ts" title="astro.config.ts" label="TypeScript" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'Which files does it generate, and which ones are on by default?',
        a: 'robots.txt and sitemap.xml are generated by default; llms.txt, llms-full.txt, rss.xml, security.txt and humans.txt are opt-in and only written once their option is configured.',
      },
      {
        q: 'Which preset keeps my site visible in ChatGPT, Gemini and Claude?',
        a: 'citationFriendly allows every crawler that answers prompts or builds an AI search index, including Google-Extended, which the Gemini app needs to cite you, and blocks crawlers whose only purpose is training. openToAi also allows training, so your content can become part of a model’s general knowledge. AI Overviews in Google Search follow Googlebot, not these rules.',
      },
      {
        q: 'Does robots.txt actually stop AI crawlers from scraping my site?',
        a: 'No — robots.txt is voluntary, and many scrapers since 2025-2026 no longer identify themselves as bots. Blocking crawlers that do comply still requires pairing a preset like blockTraining or lockdown with real infrastructure such as rate limiting or bot detection.',
      },
      {
        q: 'Does this replace @casoon/astro-crawler-policy or @casoon/astro-sitemap?',
        a: 'Yes. @casoon/astro-site-files is the successor to both — it covers robots.txt and llms.txt from astro-crawler-policy, and sitemap.xml and rss.xml from astro-sitemap, which are no longer actively maintained.',
      },
    ]}
  />

  <CallToAction
    title="Five generated files in three steps."
    href={url('docs/getting-started/quickstart/')}
    label="Read the quickstart"
  />
</Base>

<style>
  /* Links inside changelog entries need more than colour to stand out from the text. */
  :global(.release-highlights li a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
