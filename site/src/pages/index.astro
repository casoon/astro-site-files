---
import {
  Badge,
  Badges,
  BuildOutput,
  CodeBlock,
  Facts,
  Features,
  FileSet,
  Hero,
  Install,
  Quickstart,
  Terminal,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import pages from 'virtual:casoon-pages/config';
import { generatedFile } from '../inline-generated-files';

const config = `import { defineConfig } from 'astro/config'
import siteFiles from '@casoon/astro-site-files'

export default defineConfig({
  site: 'https://example.com',
  integrations: [
    siteFiles({
      robots: { preset: 'seoOnly' },
      llms: { title: 'Example', description: 'An example website.' },
      security: { contact: 'mailto:security@example.com', expires: '2027-03-01T00:00:00.000Z' },
      humans: { team: [{ name: 'Alice', role: 'Development' }] },
    }),
  ],
})`;

// The hero shows the options object alone; the quickstart below has the whole file.
const heroConfig = `siteFiles({
  robots: { preset: 'seoOnly' },
  llms: { title: 'Example', description: 'An example website.' },
  sitemap: {},
  security: { contact: 'mailto:security@example.com' },
  humans: { team: [{ name: 'Alice', role: 'Development' }] },
})`;

// Every file this site's own build wrote, in the order the documentation introduces them.
const generated = [
  { id: 'robots', name: 'robots.txt', path: 'dist/robots.txt' },
  { id: 'llms', name: 'llms.txt', path: 'dist/llms.txt' },
  { id: 'sitemap', name: 'sitemap.xml', path: 'dist/sitemap.xml' },
  { id: 'security', name: 'security.txt', path: 'dist/.well-known/security.txt' },
  { id: 'humans', name: 'humans.txt', path: 'dist/humans.txt' },
];
---

<Base>
  <Hero
    layout="stack"
    command="astro build"
    title="One typed config, five generated files."
    lead="@casoon/astro-site-files writes robots.txt, llms.txt, sitemap.xml, security.txt and humans.txt into the build output when astro build runs. The files below are the ones this build wrote."
  >
    <CodeBlock slot="source" code={heroConfig} lang="ts" title="astro.config.ts" label="TypeScript" />
    <FileSet slot="output" files={generated}>
      <Fragment slot="robots" set:html={generatedFile('robots.txt')} />
      <Fragment slot="llms" set:html={generatedFile('llms.txt')} />
      <Fragment slot="sitemap" set:html={generatedFile('sitemap.xml')} />
      <Fragment slot="security" set:html={generatedFile('.well-known/security.txt')} />
      <Fragment slot="humans" set:html={generatedFile('humans.txt')} />
    </FileSet>
    <Install
      commands={[
        { label: 'npm', command: 'npm install @casoon/astro-site-files' },
        { label: 'pnpm', command: 'pnpm add @casoon/astro-site-files' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>npm {pages.version}</Badge>
      <Badge>Astro ≥ 6</Badge>
      <Badge>Node.js ≥ 22.12</Badge>
    </Badges>
  </Hero>

  <Facts
    items={[
      { value: '6', label: 'file types written at build time' },
      { value: '64', label: 'crawlers in the built-in bot registry' },
      { value: '162', label: 'tests in the suite' },
      { value: '0', label: 'runtime dependencies' },
    ]}
  />

  <Features
    items={[
      {
        title: 'robots.txt from presets',
        body: 'Five presets from seoOnly to lockdown decide per bot group; single bots and whole groups can be overridden. Global rules are repeated in every allow group, because a crawler obeys only its most specific group.',
      },
      {
        title: 'Sitemap from the build output',
        body: 'Pages come from what Astro built. Redirect and noindex pages are dropped, hreflang alternates follow the Astro i18n config, and more than 50,000 URLs switch to a sitemap index.',
      },
      {
        title: 'Typed per file',
        body: 'Each file has its own options interface (RobotsOptions, LlmsOptions, SitemapOptions, SecurityOptions, HumansOptions), exported for your own config modules.',
      },
      {
        title: 'Audited during the build',
        body: '15 audit rules report problems in the build log, among them an expired security.txt, a contact without URI scheme and legal pages blocked in robots.txt.',
      },
    ]}
  />

  <BuildOutput
    caption="Generated by @casoon/astro-site-files while this site was built, from the configuration in site/src/site-files.ts. The showcase shows all five files."
    file="dist/humans.txt"
  >
    <Terminal>
      <Fragment set:html={generatedFile('humans.txt')} />
    </Terminal>
  </BuildOutput>

  <Quickstart
    lead="Three steps from install to generated files. The full walkthrough lives in the documentation."
    steps={[
      'Install the package and set <code>site</code> in your Astro config.',
      'Add <code>siteFiles()</code> to <code>integrations</code> with the files you want.',
      'Run <code>astro build</code>. The files are written to <code>dist/</code>.',
    ]}
  >
    <CodeBlock code={config} lang="ts" title="astro.config.ts" label="TypeScript" />
  </Quickstart>
</Base>
